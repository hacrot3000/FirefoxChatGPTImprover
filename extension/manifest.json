{
  "manifest_version": 3,
  "name": "Firefox ChatAI Assistant",
  "version": "0.41.13",
  "description": "Firefox and Chromium ChatAI Assistant with accessible keyboard-first tab automation, prompt templates, per-rule statistics, command-log export, managed downloads, Native Host actions, reusable profiles, shortcuts, and saved working sessions.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-chat-assistant@duongtc.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sessions",
    "notifications",
    "nativeMessaging",
    "downloads",
    "webRequest",
    "webRequestBlocking"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_title": "Open and activate Firefox ChatAI Assistant",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": [
      "shared/browser_compat.js",
      "shared/protocol.js",
      "shared/settings.js",
      "shared/alert_sound.js",
      "shared/command_presets.js",
      "shared/local_actions.js",
      "shared/prompt_templates.js",
      "shared/configuration_bundle.js",
      "shared/settings_snapshots.js",
      "shared/working_session.js",
      "shared/recovery.js",
      "shared/support_bundle.js",
      "background/background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "Firefox ChatAI Assistant",
    "default_panel": "sidebar/sidebar.html",
    "open_at_install": false
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Firefox ChatAI Assistant sidebar"
    },
    "fci-toggle-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Activate, pause, or resume the current tab"
    },
    "fci-acknowledge-current-alert": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Acknowledge the current tab alert"
    },
    "fci-run-current-target-action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Run the configured target action in the current tab"
    },
    "fci-open-current-command-log": {
      "description": "Open the current tab command log in the sidebar"
    },
    "fci-stop-current-tab": {
      "description": "Stop Firefox ChatAI Assistant in the current tab"
    }
  }
}
